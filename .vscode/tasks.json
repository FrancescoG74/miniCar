{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build Desktop (Linux/macOS/Windows)",
            "type": "shell",
            "command": "cmake",
            "args": [
                "-S", ".",
                "-B", "build",
                "-G", "Ninja"
            ],
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared"
            },
            "problemMatcher": "$gcc"
        },
        {
            "label": "Build Desktop and Run",
            "type": "shell",
            "command": "/bin/bash",
            "args": [
                "-c",
                "cmake -S . -B build -G Ninja && cmake --build build && ./build/minicar"
            ],
            "isBackground": false,
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": true,
                "panel": "shared"
            },
            "dependsOn": [],
            "problemMatcher": "$gcc"
        },
        {
            "label": "Build Android (Debug)",
            "type": "shell",
            "command": "gradlew.bat",
            "args": [
                "assembleDebug"
            ],
            "windows": {
                "command": "gradlew.bat"
            },
            "linux": {
                "command": "./gradlew"
            },
            "osx": {
                "command": "./gradlew"
            },
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared"
            },
            "problemMatcher": [],
            "group": {
                "kind": "build",
                "isDefault": false
            }
        },
        {
            "label": "Build Android (Release)",
            "type": "shell",
            "command": "gradlew.bat",
            "args": [
                "assembleRelease"
            ],
            "windows": {
                "command": "gradlew.bat"
            },
            "linux": {
                "command": "./gradlew"
            },
            "osx": {
                "command": "./gradlew"
            },
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared"
            },
            "problemMatcher": [],
            "group": {
                "kind": "build",
                "isDefault": false
            }
        },
        {
            "label": "Run Tests (Desktop)",
            "type": "shell",
            "command": "ctest",
            "args": [
                "--test-dir", "build",
                "--output-on-failure"
            ],
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared"
            },
            "problemMatcher": [],
            "dependsOn": ["Build Desktop (Linux/macOS/Windows)"]
        }
    ]
}

