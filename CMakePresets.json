{
    "version": 6,
    "configurePresets": [
        {
            "name": "default-linux",
            "displayName": "Linux (Default)",
            "description": "Default build configuration for Linux",
            "generator": "Ninja",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "CMAKE_CXX_COMPILER": "/usr/bin/g++",
                "MINICAR_BUILD_TESTS": "ON"
            },
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Linux"
            },
            "binaryDir": "${sourceDir}/build"
        },
        {
            "name": "default-macos",
            "displayName": "macOS (Default)",
            "description": "Default build configuration for macOS",
            "generator": "Ninja",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "CMAKE_CXX_COMPILER": "/usr/bin/clang++",
                "MINICAR_BUILD_TESTS": "ON"
            },
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Darwin"
            },
            "binaryDir": "${sourceDir}/build"
        },
        {
            "name": "default-windows",
            "displayName": "Windows (Default)",
            "description": "Default build configuration for Windows with vcpkg",
            "generator": "Ninja",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "CMAKE_TOOLCHAIN_FILE": "C:/vcpkg/scripts/buildsystems/vcpkg.cmake",
                "MINICAR_BUILD_TESTS": "ON"
            },
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Windows"
            },
            "binaryDir": "${sourceDir}/build"
        },
        {
            "name": "debug",
            "displayName": "Debug Build",
            "description": "Debug configuration for development",
            "inherits": "default-linux",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug"
            }
        },
        {
            "name": "release",
            "displayName": "Release Build",
            "description": "Release configuration for deployment",
            "inherits": "default-linux",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "default",
            "configurePreset": "default-linux",
            "inheritConfigureEnvironment": true
        },
        {
            "name": "debug",
            "configurePreset": "debug",
            "jobs": 4,
            "targets": ["minicar", "minicar_tests"]
        },
        {
            "name": "release",
            "configurePreset": "release",
            "jobs": 4,
            "targets": ["minicar"]
        }
    ],
    "testPresets": [
        {
            "name": "default",
            "configurePreset": "default-linux",
            "output": {
                "outputOnFailure": true
            },
            "execution": {
                "stopOnFailure": false
            }
        }
    ]
}

